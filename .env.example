# B 站工具的可选环境变量（优先级高于 config.json）

# 平时不用改这里：如果宿主提供了设置界面，就在界面里调参数即可，
# 界面会写入与 mcp_server.py 同级的 config.json。
# 注意仓库本身不会加载 .env；环境变量要由启动 MCP Server 的进程提供
# （常驻宿主通常有自己的 .env）。下面的写法只是参考。

# 另外指定 config.json 的位置（默认是本仓库根目录）
# BILI_CONFIG_PATH=D:\path\to\config.json

# 宿主与 MCP Server 分属不同进程或目录、需要共用冷处理名单时，
# 让两边指向同一个 agent.avoid.json
# BILI_AVOID_PATH=D:\path\to\agent.avoid.json

# 视频投稿白名单目录（默认仓库内 data/uploads/）；只能上传这个目录里的视频
# BILI_UPLOAD_DIR=data/uploads

# 超长视频保护：原视频超过这个分钟数时，概览和高清补帧直接拒绝
# 范围 1-600
# BILI_MAX_VIDEO_MINUTES=60

# 密集联系表（第一层概览）
# BILI_DENSE_INTERVAL_SECONDS=3.0    # 每几秒取一帧，0.5-60
# BILI_DENSE_MAX_FRAMES=40           # 一张最多几帧，1-120
# BILI_DENSE_HEIGHT=480              # 单帧高度 px，240-2160

# 按时间点抽高清帧（第二层）
# BILI_FRAMES_MAX=3                  # 单次最多几张，1-9
# BILI_FRAMES_MAX_HEIGHT=1080        # 最高抽帧高度 px，360-2160
# BILI_FRAMES_MAX_AGE_SECONDS=3600   # 临时帧保留秒数，60-86400

# 概览窗口与雪碧图
# BILI_WINDOW_SECONDS=120            # 单窗口时长秒，10-600
# BILI_STORYBOARD_MAX_FRAMES=24      # 雪碧图最多几帧，1-60

# 审计日志目录（默认仓库内 logs/）；宿主可以指到自己的日志目录
# BILI_MCP_LOG_DIR=logs
